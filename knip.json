{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/main.tsx",
        "scripts/*.mjs"
      ]
    },
    "packages/ui": {
      "entry": ["src/abacus/AbacusApp.tsx", "src/abacus/bridge.ts"],
      "ignore": ["src/components/**"]
    }
  }
}
