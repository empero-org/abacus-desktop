{
  "name": "abacus-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "The Abacus desktop app: a workspace window for the abacus coding agent.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @abacus/desktop dev",
    "build": "pnpm --filter @abacus/desktop build",
    "package": "pnpm --filter @abacus/desktop package",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "knip": "^6.0.6",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  }
}
